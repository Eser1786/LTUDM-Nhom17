<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tkb.frontend.HomeController"
      alignment="CENTER"
      spacing="20"
      style="-fx-padding: 30;">

    <Label text="HỆ THỐNG QUẢN LÝ THỜI KHÓA BIỂU"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label text="Chào mừng bạn đến với hệ thống."/>

    <Button text="Xem thời khóa biểu"
            onAction="#handleViewSchedule"/>

</VBox>